    <connection>SIAPE-H</connection>
    <sql>SELECT
	PV.COD_INSTITUCIONAL MATRICULA_H,
    PV.ID_PESSOA_VINCULO ID_PESSOA_VINCULO_H,
    BFP.ID_DISPOSITIVO_PONTO ID_DISPOSITIVO_PONTO_H_C,
    BFP.IDEN_DISPOSITIVO IDEN_DISPOSITIVO_H_C,
    BFP.LOCALIZACAO LOCALIZACAO_H_C,
    BFP.IDENTIFICADOR_UNICO IDENTIFICADOR_UNICO_H_C,
    BFP.IND_STATUS IND_STATUS_H_C,
    BFP.MARCA MARCA_H_C,
    BFP.MODELO MODELO_H_C,
    BFP.VERSAO_SISTEMA VERSAO_SISTEMA_H_C,
    BFP.VERSAO_APP VERSAO_APP_H_C,
    BFP.IND_TIPO_DISPOSITIVO IND_TIPO_DISPOSITIVO_H_C,
    BFP.ID_PESSOA_VINCULO ID_PESSOA_VINCULO_H_C,
	BFP.ID_FUNCIONARIO ID_FUNCIONARIO_H_C
FROM
	${SCHEMA}.DISPOSITIVO_PONTO BFP
	LEFT JOIN ${SCHEMA}.FUNCIONARIO F ON F.ID_FUNCIONARIO = BFP.ID_FUNCIONARIO
    LEFT JOIN ${SCHEMA}.PESSOA_VINCULO PV ON PV.ID_PESSOA_VINCULO = F.ID_PESSOA_VINCULO
ORDER BY
	BFP.ID_DISPOSITIVO_PONTO</sql>
