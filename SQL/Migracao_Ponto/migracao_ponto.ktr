	BFP.ID_FUNCIONARIO ID_FUNCIONARIO_H_C
FROM
	${SCHEMA}.JUSTIFICATIVA_PONTO BFP
	LEFT JOIN ${SCHEMA}.FUNCIONARIO F ON F.ID_FUNCIONARIO = BFP.ID_FUNCIONARIO
    LEFT JOIN ${SCHEMA}.PESSOA_VINCULO PV ON PV.ID_PESSOA_VINCULO = F.ID_PESSOA_VINCULO
ORDER BY
	BFP.ID_JUSTIFICATIVA_PONTO</sql>
