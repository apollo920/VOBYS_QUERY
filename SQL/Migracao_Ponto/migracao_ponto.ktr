      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>SIAPE-H</connection>
    <sql>SELECT
    PV.COD_INSTITUCIONAL MATRICULA_H,
    PV.ID_PESSOA_VINCULO ID_PESSOA_VINCULO_H,
    BFP.ID_BATI_FREQ_PONTO ID_BATI_FREQ_PONTO_H_C,
    BFP.DATA_HORA_BATIDA DATA_HORA_BATIDA_H_C,
    BFP.ID_DISPOSITIVO ID_DISPOSITIVO_H_C,
    BFP.IP_DISPOSITIVO IP_DISPOSITIVO_H_C,
    BFP.IND_STATUS IND_STATUS_H_C,
    BFP.OBSERVACAO OBSERVACAO_H_C,
    BFP.LOCALIZACAO LOCALIZACAO_H_C,
    BFP.ENDERECO ENDERECO_H_C,
    BFP.IND_ALTE_MANUALMENTE IND_ALTE_MANUALMENTE_H_C,
    BFP.NSR NSR_H_C,
    BFP.DATA_HORA_GRAVACAO DATA_HORA_GRAVACAO_H_C,
    BFP.ID_COLETOR_MARCACAO ID_COLETOR_MARCACAO_H_C,
    BFP.HASH_SHA256 HASH_SHA256_H_C,
    BFP.IND_TIPO_BATIDA IND_TIPO_BATIDA_H_C,
    BFP.ID_PESSOA_VINCULO ID_PESSOA_VINCULO_H_C,
	BFP.ID_FUNCIONARIO ID_FUNCIONARIO_H_C
FROM
	${SCHEMA}.BATI_FREQ_PONTO BFP
	LEFT JOIN ${SCHEMA}.FUNCIONARIO F ON F.ID_FUNCIONARIO = BFP.ID_FUNCIONARIO
    LEFT JOIN ${SCHEMA}.PESSOA_VINCULO PV ON PV.ID_PESSOA_VINCULO = F.ID_PESSOA_VINCULO
ORDER BY
	BFP.ID_BATI_FREQ_PONTO</sql>
