    <connection>SIAPE-H</connection>
    <sql>SELECT
      e.ID_PESSOA_VINCULO,
      deOld.IDENTIFICADOR_UNICO,
      be.IP_DISPOSITIVO,
      be.DATA_HORA_BATIDA,
      be.DATA_HORA_GRAVACAO,
      be.LOCALIZACAO,
      be.MODELO,
      be.PRECISAO_LOCALIZACAO,
      be.ERRO_CALCULADO,
      be.ENDERECO,
      be.FOTO_BATIDA,
      be.IND_MOTIVO_RECUSA,
      be.DETALHE_RECUSA,
      be.IND_STATUS,
      be.DATA_REVISAO,
      be.ID_GESTOR_REVISAO,
      be.OBSERVACAO_REVISAO
FROM
      ${SCHEMA}.BATIDA_PENDENTE_ESTAGIARIO be
      JOIN ${SCHEMA}.ESTAGIARIO e ON e.ID_ESTAGIARIO = be.ID_ESTAGIARIO
      LEFT JOIN ${SCHEMA}.DISPOSITIVO_PONTO_ESTAGIARIO deOld ON deOld.ID_DISPOSITIVO_PONTO_ESTAG = be.ID_DISPOSITIVO</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
