    <connection>SIAPE-H</connection>
    <sql>SELECT
    e.ID_PESSOA_VINCULO,
    deOld.IDENTIFICADOR_UNICO,
    be.DATA_HORA_BATIDA,
    be.IP_DISPOSITIVO,
    be.IND_STATUS,
    be.OBSERVACAO,
    be.LOCALIZACAO,
    be.ENDERECO,
    be.IND_ALTE_MANUALMENTE,
    be.NSR,
    be.DATA_HORA_GRAVACAO,
    be.ID_COLETOR_MARCACAO,
    be.HASH_SHA256,
    be.IND_TIPO_BATIDA
FROM
    ${SCHEMA}.BATI_FREQ_PONTO_ESTAG be
    JOIN ${SCHEMA}.ESTAGIARIO e ON e.ID_ESTAGIARIO = be.ID_ESTAGIARIO
    LEFT JOIN ${SCHEMA}.DISPOSITIVO_PONTO_ESTAGIARIO deOld ON deOld.ID_DISPOSITIVO_PONTO_ESTAG = be.ID_DISPOSITIVO_ESTAGIARIO</sql>
